    "check:colors": "node scripts/check-colors.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm typecheck && pnpm check:colors && pnpm test && pnpm build"
  },
