<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SoufflePet.ViewModels"
        xmlns:models="using:SoufflePet.Models"
        x:Class="SoufflePet.Views.ChatWindow"
        x:DataType="vm:ChatViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}"
        Width="420"
        Height="620"
        CanResize="True"
        MinWidth="360"
        MinHeight="480"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark">
    <!-- 深色玻璃面板的外观样式统一放在 Styles 文件夹，由 App.axaml 引入 -->

    <!-- 面板直接铺满窗口：无边框窗口的真实边界就是可见面板边界，不再留投影用的透明边 -->
    <Panel>
        <Border Background="#EA17181D"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                <!-- 标题栏：按住可拖动无边框窗口 -->
                <Border Background="Transparent" PointerPressed="OnHeaderPointerPressed">
                    <Grid Height="52" Margin="16,0,10,0" ColumnDefinitions="Auto,*,Auto">
                        <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#F2A9B8" Offset="0" />
                                    <GradientStop Color="#D97F9A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding PetInitial}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#2A141B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PetName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF" />
                            <TextBlock Text="LLM 对话" FontSize="11" Foreground="#8CFFFFFF" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Classes="ghost"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Click="OnCloseClick">
                            <Path Data="M0,0 L9,9 M9,0 L0,9"
                                  Stroke="#8CFFFFFF"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Height="1" Background="#14FFFFFF" />

                <!-- 提问面板：模型调用 ask_user 时出现在消息区下方、输入框上方，全部回答后提交给模型 -->
                <Border Grid.Row="3"
                        Margin="12,0,12,8"
                        Padding="12,10"
                        CornerRadius="12"
                        Background="#1FE8879B"
                        BorderBrush="#59E8879B"
                        BorderThickness="1"
                        IsVisible="{Binding IsAsking}">
                    <!-- 模板内部以 AskUser 为数据上下文，避免在面板隐藏时对 null 取子属性 -->
                    <ContentControl Content="{Binding AskUser}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:AskUserViewModel">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <!-- 顶部：标题 + 右上角页码与翻页按钮 -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="需要你补充一些信息"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F2FFFFFF"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    VerticalAlignment="Center">
                                            <Button Classes="ghost"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    ToolTip.Tip="上一题"
                                                    ToolTip.Placement="Top"
                                                    ToolTip.VerticalOffset="-6"
                                                    Command="{Binding PreviousCommand}">
                                                <Path Data="M5,0 L0,5 L5,10"
                                                      Stroke="#B3FFFFFF"
                                                      StrokeThickness="1.4"
                                                      StrokeLineCap="Round"
                                                      StrokeJoin="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Button>
                                            <TextBlock Text="{Binding PageText}"
                                                       MinWidth="36"
                                                       TextAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="#B3FFFFFF"
                                                       VerticalAlignment="Center" />
                                            <Button Classes="ghost"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    ToolTip.Tip="下一题"
                                                    ToolTip.Placement="Top"
                                                    ToolTip.VerticalOffset="-6"
                                                    Command="{Binding NextCommand}">
                                                <Path Data="M0,0 L5,5 L0,10"
                                                      Stroke="#B3FFFFFF"
                                                      StrokeThickness="1.4"
                                                      StrokeLineCap="Round"
                                                      StrokeJoin="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 当前问题：一页一个，选项每行一个 -->
                                    <ScrollViewer Grid.Row="1"
                                                  Margin="0,8,0,0"
                                                  MaxHeight="220"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ContentControl Content="{Binding CurrentQuestion}"
                                                        HorizontalContentAlignment="Stretch">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="vm:AskQuestionViewModel">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontSize="12.5"
                                                                   LineHeight="18"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#F2FFFFFF" />

                                                        <!-- 预设选项 + 固定的「其他（自由输入）」，每行一个 -->
                                                        <ItemsControl ItemsSource="{Binding Options}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Spacing="2" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:AskOptionViewModel">
                                                                    <RadioButton GroupName="{Binding GroupName}"
                                                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                            HorizontalAlignment="Stretch"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Padding="4,3"
                                                                            FontSize="12"
                                                                            Foreground="#D9FFFFFF">
                                                                        <StackPanel Spacing="1">
                                                                            <TextBlock Text="{Binding Text}"
                                                                                    TextWrapping="NoWrap"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            <!-- 说明小字：不换行，超长截断，悬停看全文 -->
                                                                            <TextBlock Text="{Binding Description}"
                                                                                    IsVisible="{Binding HasDescription}"
                                                                                    FontSize="10.5"
                                                                                    Foreground="#8CFFFFFF"
                                                                                    TextWrapping="NoWrap"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    ToolTip.Tip="{Binding Description}"
                                                                                    ToolTip.Placement="Top"
                                                                                    ToolTip.VerticalOffset="-6"
                                                                                    ToolTip.ShowDelay="300" />
                                                                        </StackPanel>
                                                                    </RadioButton>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 选中自由输入项后展开；按 Enter 进入下一题 -->
                                                        <TextBox Classes="field"
                                                                 IsVisible="{Binding IsCustomSelected}"
                                                                 Text="{Binding CustomText, Mode=TwoWay}"
                                                                 AcceptsReturn="False"
                                                                 PlaceholderText="输入你的回答，按 Enter 下一题"
                                                                 KeyDown="OnAnswerInputKeyDown" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8"
                                                Margin="0,8,0,0">
                                        <Button Classes="secondary"
                                                Content="取消"
                                                Command="{Binding CancelCommand}" />
                                        <Button Classes="primary"
                                                Content="提交"
                                                Command="{Binding SubmitCommand}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>

                <!-- 消息区 -->
                <!-- 关闭 BringIntoViewOnFocusChange：窗口重新激活时会恢复上次聚焦的气泡/按钮，
                     默认行为会把该控件滚回可视区，导致切回窗口时消息列表意外滚动 -->
                <ScrollViewer Name="MessageScroll"
                              Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              AllowAutoHide="True"
                              BringIntoViewOnFocusChange="False">
                    <!-- 消息高度差异极大（折叠面板、图片、流式文本），VirtualizingStackPanel
                         会按平均高度估算未实现项的总高度：流式输出时平均高度不断漂移，
                         估算的滚动范围随之抖动，贴底滚动会被反复拉回。
                         这里用普通 StackPanel，布局高度始终精确；恢复的历史只有最近 10 轮，
                         气泡数量有限，不虚拟化的开销可以接受 -->
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="16,14,16,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessage">
                                <Border Classes="bubble"
                                        Margin="0,0,0,10"
                                        Classes.user="{Binding IsUser}"
                                        Classes.tool="{Binding IsTool}"
                                        Classes.thinking="{Binding IsReasoning}"
                                        Classes.approval="{Binding IsApproval}"
                                        Classes.notice="{Binding IsPlatformNotice}">
                                    <StackPanel Spacing="7">
                                        <!-- 思考过程：折叠面板，思考结束自动收起，点标题可展开回看。
                                             用 ContentControl 承载：Content 为 null（非思考消息）时不实例化模板，
                                             避免每条普通气泡都创建一个用不到的折叠面板 -->
                                        <ContentControl Content="{Binding ReasoningPanel}"
                                                        IsVisible="{Binding IsReasoning}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="models:ChatMessage">
                                                    <Expander Theme="{StaticResource ToolExpander}"
                                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                              Header="{Binding ReasoningHeader}">
                                                        <SelectableTextBlock Text="{Binding Text}"
                                                                             TextWrapping="Wrap" />
                                                    </Expander>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>

                                        <!-- 工具调用：折叠面板，标题是工具名与参数，展开后看执行结果（同样按需实例化） -->
                                        <ContentControl Content="{Binding ToolPanel}"
                                                        IsVisible="{Binding IsToolPanel}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="models:ChatMessage">
                                                    <Expander Theme="{StaticResource ToolExpander}"
                                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding ToolHeader}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Expander.Header>
                                                        <SelectableTextBlock Text="{Binding ToolBody}"
                                                                             TextWrapping="Wrap" />
                                                    </Expander>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>

                                        <SelectableTextBlock Text="{Binding Text}" IsVisible="{Binding IsPlain}" />

                                        <!-- 本地附件：图片直接预览，其他文件显示为可点击打开的卡片。
                                             用 ContentControl 承载：Content 为 null 时不实例化模板，
                                             避免对大多数普通消息绑定 DisplayAttachment 触发空值绑定错误 -->
                                        <ContentControl Content="{Binding DisplayAttachment}"
                                                        IsVisible="{Binding HasDisplayAttachment}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="models:ChatDisplayAttachment">
                                                    <StackPanel Spacing="6">
                                                        <Button Classes="ghost"
                                                                Padding="0"
                                                                HorizontalAlignment="Left"
                                                                IsVisible="{Binding HasImage}"
                                                                Command="{Binding OpenCommand}"
                                                                ToolTip.Tip="{Binding FilePath}"
                                                                ToolTip.Placement="Top">
                                                            <Image Source="{Binding Image}"
                                                                   MaxWidth="260"
                                                                   MaxHeight="240"
                                                                   Stretch="Uniform" />
                                                        </Button>
                                                        <Button Classes="ghost"
                                                                Padding="8,4"
                                                                HorizontalAlignment="Left"
                                                                IsVisible="{Binding IsFileCard}"
                                                                Command="{Binding OpenCommand}"
                                                                ToolTip.Tip="{Binding FilePath}"
                                                                ToolTip.Placement="Top">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       MaxWidth="240"
                                                                       FontSize="11.5"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>

                                        <!-- 本轮 token 用量：助手消息结束后显示在气泡底部 -->
                                        <TextBlock Text="{Binding UsageText}"
                                                   IsVisible="{Binding HasUsage}"
                                                   FontSize="10.5"
                                                   LineHeight="16"
                                                   Foreground="#59FFFFFF" />

                                        <!-- 手动审批：等待用户决定时才显示按钮 -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="7"
                                                    IsVisible="{Binding IsPending}">
                                            <Button Classes="approval accept"
                                                    Content="允许"
                                                    Command="{Binding ApproveCommand}" />
                                            <Button Classes="approval reject"
                                                    Content="拒绝"
                                                    Command="{Binding RejectCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区：多行文本框 + 下方「附件 / 模型 / 发送」操作行 -->
                <Border Grid.Row="4"
                        Margin="12,4,12,12"
                        Padding="10,8"
                        CornerRadius="12"
                        Background="#0FFFFFFF"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <!-- 待发送的附件：只记绝对路径，发送时以 @路径 附加到消息里 -->
                        <StackPanel Grid.Row="0" Spacing="4">
                            <ItemsControl ItemsSource="{Binding Attachments}"
                                          IsVisible="{Binding HasAttachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChatAttachment">
                                        <Border Background="#1FFFFFFF"
                                                CornerRadius="6"
                                                Padding="6,2"
                                                Margin="0,0,4,4">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding FileName}"
                                                           MaxWidth="170"
                                                           FontSize="10.5"
                                                           Foreground="#D9FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding FullPath}"
                                                           ToolTip.Placement="Top" />
                                                <Button Classes="ghost"
                                                        Width="14"
                                                        Height="14"
                                                        Padding="0"
                                                        ToolTip.Tip="移除附件"
                                                        ToolTip.Placement="Top"
                                                        Click="OnRemoveAttachmentClick">
                                                    <Path Data="M0,0 L6,6 M6,0 L0,6"
                                                          Stroke="#8CFFFFFF"
                                                          StrokeThickness="1.2"
                                                          StrokeLineCap="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding AttachmentHint}"
                                       IsVisible="{Binding HasAttachmentHint}"
                                       FontSize="10.5"
                                       Foreground="#FF9E9E"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 外观交给 .bare 样式覆盖主题底色，并去掉聚焦时的蓝色装饰层 -->
                        <TextBox Grid.Row="1"
                                 Name="InputBox"
                                 Classes="bare"
                                 Text="{Binding Draft, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="{Binding InputPlaceholder}"
                                 FocusAdorner="{x:Null}"
                                 Foreground="#F2FFFFFF"
                                 CaretBrush="#E8879B"
                                 FontSize="13"
                                 LineHeight="20"
                                 Padding="2"
                                 MinHeight="62"
                                 MaxHeight="132" />

                        <!-- 左侧操作项允许收缩裁剪，发送按钮固定在右侧，永远不会被顶出窗口 -->
                        <Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6" ClipToBounds="True">
                                <Button Name="MoreButton"
                                        Classes="ghost"
                                        ToolTip.Tip="更多操作"
                                        ToolTip.Placement="Top"
                                        ToolTip.VerticalOffset="-6"
                                        Command="{Binding ToggleMoreCommand}">
                                    <Path Data="M0,6 L12,6 M6,0 L6,12"
                                          Stroke="#8CFFFFFF"
                                          StrokeThickness="1.4"
                                          StrokeLineCap="Round"
                                          VerticalAlignment="Center" />
                                </Button>
                                <Button Name="ApprovalButton"
                                        Classes="ghost"
                                        ToolTip.Tip="命令执行审批规则"
                                        ToolTip.Placement="Top"
                                        ToolTip.VerticalOffset="-6"
                                        Command="{Binding ToggleApprovalPickerCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#E8879B" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ApprovalButtonText}" Classes="muted" />
                                    </StackPanel>
                                </Button>
                                <Button Name="ModelButton"
                                        Classes="ghost"
                                        ToolTip.Tip="选择模型"
                                        ToolTip.Placement="Top"
                                        ToolTip.VerticalOffset="-6"
                                        Command="{Binding ToggleModelPickerCommand}">
                                    <TextBlock Text="{Binding ModelButtonText}"
                                               Classes="muted"
                                               TextTrimming="CharacterEllipsis" />
                                </Button>


                            </StackPanel>

                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Classes="primary"
                                    Content="发送"
                                    IsVisible="{Binding !IsGenerating}"
                                    Command="{Binding SendCommand}" />

                            <!-- 生成期间同一位置换成停止按钮 -->
                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Classes="primary"
                                    Content="停止"
                                    IsVisible="{Binding IsGenerating}"
                                    Command="{Binding StopCommand}" />

                            <!-- 模型选择浮层：列表底部固定一个「添加模型」入口 -->
                            <Popup Grid.Column="0" IsOpen="{Binding IsModelPickerOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding #ModelButton}"
                                   Placement="TopEdgeAlignedLeft"
                                   VerticalOffset="-4"
                                   IsLightDismissEnabled="True">
                                <Border Width="236"
                                        Padding="6"
                                        Background="#F21B1C22"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        BoxShadow="0 10 28 0 #80000000">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="选择模型"
                                                   FontSize="11"
                                                   Foreground="#66FFFFFF"
                                                   Margin="8,4,8,2" />

                                        <ListBox Name="ModelList"
                                                 Classes="modelList"
                                                 ItemsSource="{Binding Models}"
                                                 SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                                 MaxHeight="190"
                                                 PointerReleased="OnModelListPointerReleased">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChatModelConfig">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               Foreground="#F2FFFFFF" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border Height="1" Background="#14FFFFFF" Margin="4,3" />

                                        <Button Classes="ghost"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,6"
                                                Command="{Binding OpenAddModelCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="7"
                                                        VerticalAlignment="Center">
                                                <Path Data="M0,6 L12,6 M6,0 L6,12"
                                                      Stroke="#8CFFFFFF"
                                                      StrokeThickness="1.4"
                                                      StrokeLineCap="Round"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="添加模型" Classes="muted" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- 更多操作浮层：添加附件、MCP 服务器与技能配置入口 -->
                            <Popup Grid.Column="0" IsOpen="{Binding IsMoreOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding #MoreButton}"
                                   Placement="TopEdgeAlignedLeft"
                                   VerticalOffset="-4"
                                   IsLightDismissEnabled="True">
                                <Border Width="212"
                                        Padding="6"
                                        Background="#F21B1C22"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        BoxShadow="0 10 28 0 #80000000">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="更多操作"
                                                   FontSize="11"
                                                   Foreground="#66FFFFFF"
                                                   Margin="8,4,8,2" />

                                        <Button Classes="modeItem" Click="OnAttachClick">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="添加附件…" FontSize="12.5" Foreground="#F2FFFFFF" />
                                                <TextBlock Text="所有附件只附带 @绝对路径，模型可随时读取"
                                                           FontSize="10.5"
                                                           Foreground="#66FFFFFF"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="modeItem" Command="{Binding OpenMcpSettingsCommand}">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="MCP 服务器…" FontSize="12.5" Foreground="#F2FFFFFF" />
                                                <TextBlock Text="配置模型可调用的外部工具"
                                                           FontSize="10.5"
                                                           Foreground="#66FFFFFF" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="modeItem" Command="{Binding OpenSkillsCommand}">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="技能…" FontSize="12.5" Foreground="#F2FFFFFF" />
                                                <TextBlock Text="管理模型可读取的技能说明"
                                                           FontSize="10.5"
                                                           Foreground="#66FFFFFF" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="modeItem" Command="{Binding OpenPluginsCommand}">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="插件…" FontSize="12.5" Foreground="#F2FFFFFF" />
                                                <TextBlock Text="查看、启用或导入本地插件工具"
                                                           FontSize="10.5"
                                                           Foreground="#66FFFFFF" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="modeItem" Command="{Binding OpenScheduledTasksCommand}">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="定时任务…" FontSize="12.5" Foreground="#F2FFFFFF" />
                                                <TextBlock Text="定时唤醒桌宠执行任务"
                                                           FontSize="10.5"
                                                           Foreground="#66FFFFFF" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- 审批规则浮层：手动审批逐个确认，完全访问直接执行 -->
                            <Popup Grid.Column="0" IsOpen="{Binding IsApprovalPickerOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding #ApprovalButton}"
                                   Placement="TopEdgeAlignedLeft"
                                   VerticalOffset="-4"
                                   IsLightDismissEnabled="True">
                                <Border Width="212"
                                        Padding="6"
                                        Background="#F21B1C22"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        BoxShadow="0 10 28 0 #80000000">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="命令执行权限"
                                                   FontSize="11"
                                                   Foreground="#66FFFFFF"
                                                   Margin="8,4,8,2" />

                                        <Button Classes="modeItem" Command="{Binding UseManualApprovalCommand}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="手动审批" FontSize="12.5" Foreground="#F2FFFFFF" />
                                                    <TextBlock Text="每次执行命令前询问"
                                                               FontSize="10.5"
                                                               Foreground="#66FFFFFF" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="✓"
                                                           FontSize="12"
                                                           Foreground="#E8879B"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsManualApproval}" />
                                            </Grid>
                                        </Button>

                                        <Button Classes="modeItem" Command="{Binding UseFullAccessCommand}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="完全访问" FontSize="12.5" Foreground="#F2FFFFFF" />
                                                    <TextBlock Text="不再询问，直接执行"
                                                               FontSize="10.5"
                                                               Foreground="#66FFFFFF" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="✓"
                                                           FontSize="12"
                                                           Foreground="#E8879B"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsFullAccess}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 底部信息栏：左侧切换工作区，右侧有史以来的陪伴时长、token 用量与缓存命中率 -->
                <Grid Grid.Row="5"
                      Margin="16,0,16,10"
                      ColumnDefinitions="*,Auto">
                    <Button Name="WorkspaceButton"
                            Classes="ghost"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="{Binding WorkspaceToolTip}"
                            ToolTip.Placement="Top"
                            ToolTip.VerticalOffset="-6"
                            Command="{Binding ToggleWorkspacePickerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Path Data="M0.5,2.5 L5,2.5 L6.8,4.5 L13.5,4.5 L13.5,11 L0.5,11 Z"
                                  Stroke="#8CFFFFFF"
                                  StrokeThickness="1.2"
                                  StrokeJoin="Round"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WorkspaceButtonText}"
                                       Classes="muted"
                                       MaxWidth="160"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding UsageSummaryText}"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="#59FFFFFF" />
                    </StackPanel>

                    <!-- 工作区选择浮层：历史工作区列表 + 固定在底部的「选择工作区」入口 -->
                    <Popup Grid.Column="0" IsOpen="{Binding IsWorkspacePickerOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding #WorkspaceButton}"
                           Placement="TopEdgeAlignedLeft"
                           VerticalOffset="-4"
                           IsLightDismissEnabled="True">
                        <Border Name="WorkspacePopupRoot"
                                Width="272"
                                Padding="6"
                                Background="#F21B1C22"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                BoxShadow="0 10 28 0 #80000000">
                            <Panel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="切换工作区"
                                               FontSize="11"
                                               Foreground="#66FFFFFF"
                                               Margin="8,4,8,2" />

                                    <ScrollViewer MaxHeight="190"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Workspaces}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkspaceItem">
                                                    <Border Classes="workspaceRow"
                                                            Classes.active="{Binding IsActive}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Button Classes="ghost"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left"
                                                                    Padding="8,5"
                                                                    Click="OnWorkspaceItemClick">
                                                                <StackPanel Spacing="1">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="12.5"
                                                                               Foreground="#F2FFFFFF"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding FullPath}"
                                                                               FontSize="10.5"
                                                                               Foreground="#66FFFFFF"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Grid.Column="1"
                                                                    Classes="ghost"
                                                                    Width="22"
                                                                    Height="22"
                                                                    Padding="0"
                                                                    Margin="0,0,2,0"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip.Tip="删除工作区"
                                                                    ToolTip.Placement="Top"
                                                                    ToolTip.VerticalOffset="-6"
                                                                    Click="OnDeleteWorkspaceClick">
                                                                <Path Data="M2,3 L12,3 M5,3 L5,1.5 L9,1.5 L9,3 M3.5,3 L4.2,12 L9.8,12 L10.5,3"
                                                                      Stroke="#8CFFFFFF"
                                                                      StrokeThickness="1.2"
                                                                      StrokeLineCap="Round"
                                                                      StrokeJoin="Round"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- 空状态：没有任何历史工作区时给出提示 -->
                                    <TextBlock Text="还没有历史工作区，点击下方按钮选择目录"
                                               IsVisible="{Binding !HasWorkspaces}"
                                               Margin="8,6,8,8"
                                               FontSize="11"
                                               Foreground="#66FFFFFF"
                                               TextWrapping="Wrap" />

                                    <Border Height="1" Background="#14FFFFFF" Margin="4,3" />

                                    <Button Classes="ghost"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,6"
                                            Click="OnPickWorkspaceClick">
                                        <StackPanel Orientation="Horizontal" Spacing="7"
                                                    VerticalAlignment="Center">
                                            <Path Data="M0.5,2.5 L5,2.5 L6.8,4.5 L13.5,4.5 L13.5,11 L0.5,11 Z"
                                                  Stroke="#8CFFFFFF"
                                                  StrokeThickness="1.2"
                                                  StrokeJoin="Round"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="选择工作区…" Classes="muted" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- 删除二次确认：覆盖在浮层内容上，确认后才真正移除记录 -->
                                <Border IsVisible="{Binding IsConfirmingWorkspaceDelete}"
                                        Background="#F21B1C22"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="删除工作区？"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F2FFFFFF" />
                                        <TextBlock Text="{Binding WorkspaceDeletePrompt}"
                                                   FontSize="11"
                                                   LineHeight="17"
                                                   Foreground="#8CFFFFFF"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="8">
                                            <Button Classes="secondary"
                                                    Content="取消"
                                                    Command="{Binding CancelDeleteWorkspaceCommand}" />
                                            <Button Classes="primary"
                                                    Content="删除"
                                                    Command="{Binding ConfirmDeleteWorkspaceCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- 添加模型：覆盖整个面板的轻量表单，避免另开窗口 -->
                <Grid Grid.Row="0" Grid.RowSpan="6"
                      IsVisible="{Binding IsAddingModel}"
                      Background="#A6000000">
                    <Border Width="344"
                            Padding="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#F21B1C22"
                            BorderBrush="#26FFFFFF"
                            BorderThickness="1"
                            CornerRadius="14"
                            BoxShadow="0 14 34 0 #80000000">
                        <StackPanel Spacing="10">
                            <TextBlock Text="添加模型"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#F2FFFFFF" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="提供商（可选）" FontSize="11" Foreground="#8CFFFFFF" />
                                <TextBox Classes="field"
                                         Text="{Binding NewModelProvider, Mode=TwoWay}"
                                         PlaceholderText="例如：DeepSeek" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="名称" FontSize="11" Foreground="#8CFFFFFF" />
                                <TextBox Classes="field"
                                         Text="{Binding NewModelName, Mode=TwoWay}"
                                         PlaceholderText="例如：DeepSeek" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="模型标识" FontSize="11" Foreground="#8CFFFFFF" />
                                <TextBox Classes="field"
                                         Text="{Binding NewModelModelId, Mode=TwoWay}"
                                         PlaceholderText="例如：deepseek-chat" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="接口地址" FontSize="11" Foreground="#8CFFFFFF" />
                                <TextBox Classes="field"
                                         Text="{Binding NewModelBaseUrl, Mode=TwoWay}"
                                         PlaceholderText="https://api.example.com/v1" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="API 密钥" FontSize="11" Foreground="#8CFFFFFF" />
                                <TextBox Classes="field"
                                         Text="{Binding NewModelApiKey, Mode=TwoWay}"
                                         PasswordChar="●"
                                         PlaceholderText="可留空" />
                            </StackPanel>

                            <TextBlock Text="{Binding AddModelError}"
                                       IsVisible="{Binding HasAddModelError}"
                                       FontSize="11"
                                       Foreground="#FF9E9E" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8"
                                        Margin="0,2,0,0">
                                <Button Classes="ghost"
                                        Content="取消"
                                        Command="{Binding CancelAddModelCommand}" />
                                <Button Classes="primary"
                                        Content="添加"
                                        Command="{Binding ConfirmAddModelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Panel>
</Window>