<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\pet.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <WebUiDir>$(MSBuildProjectDirectory)\web</WebUiDir>
    <WebUiIndex>$(MSBuildProjectDirectory)\wwwroot\app\index.html</WebUiIndex>
  </PropertyGroup>

  <ItemGroup>
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Live2DCubismCore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Live2DCubismCore.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- React 源码变更时触发 pnpm build；产物在 wwwroot/app（已 gitignore）。 -->
    <WebUiSource Include="$(WebUiDir)\src\**\*;$(WebUiDir)\index.html;$(WebUiDir)\package.json;$(WebUiDir)\pnpm-lock.yaml;$(WebUiDir)\pnpm-workspace.yaml;$(WebUiDir)\vite.config.ts;$(WebUiDir)\vitest.config.ts;$(WebUiDir)\tsconfig*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 桌宠长时间挂着：让 GC 更积极地压缩堆、把空闲段还给系统（0 关闭，9 最激进）。
         构建后会写进 SoufflePet.runtimeconfig.json 的 configProperties。 -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Live2DCSharpSDK.OpenGL\Live2DCSharpSDK.OpenGL.csproj" />
    <ProjectReference Include="..\SoufflePet.Core\SoufflePet.Core.csproj" />
    <ProjectReference Include="..\SoufflePet.Plugin.Sdk\SoufflePet.Plugin.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\pet.ico" />
    <AvaloniaResource Include="Assets\pet.ico" />
  </ItemGroup>

  <!-- React UI：dotnet build 默认调用 pnpm build；-p:SkipWebBuild=true 可跳过（需已有产物）。 -->
  <Target Name="BuildWebUi" BeforeTargets="Build"
          Condition="'$(SkipWebBuild)' != 'true' and Exists('$(WebUiDir)\package.json')"
          Inputs="@(WebUiSource)" Outputs="$(WebUiIndex)">
    <Error Condition="!Exists('$(WebUiDir)\node_modules')"
           Text="SoufflePet/web 依赖未安装：请先运行 pnpm --dir SoufflePet/web install；或用 -p:SkipWebBuild=true 跳过（需已有 wwwroot/app 产物）。" />
    <Exec Command="pnpm build" WorkingDirectory="$(WebUiDir)" />
  </Target>

  <Target Name="WarnMissingWebUi" BeforeTargets="Build"
          Condition="'$(SkipWebBuild)' == 'true' and !Exists('$(WebUiIndex)')">
    <Warning Text="SkipWebBuild=true 且 wwwroot/app/index.html 不存在：运行时主窗口会显示加载错误页。" />
  </Target>

  <!-- 生成的文件在项目求值之后才出现，显式复制到 bin 与 publish 目录。 -->
  <Target Name="CopyWebUiToOutput" AfterTargets="Build">
    <ItemGroup>
      <WebUiOutputFile Include="$(MSBuildProjectDirectory)\wwwroot\app\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiOutputFile)"
          DestinationFiles="@(WebUiOutputFile->'$(OutDir)wwwroot\app\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWebUiToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WebUiPublishFile Include="$(MSBuildProjectDirectory)\wwwroot\app\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUiPublishFile)"
          DestinationFiles="@(WebUiPublishFile->'$(PublishDir)wwwroot\app\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 若宿主输出目录已有本地调试部署的插件，发布时一并带上；插件工程独立构建，不在解决方案内 -->
  <Target Name="CopyPluginsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PluginPublishFile Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginPublishFile)"
          DestinationFiles="@(PluginPublishFile->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
