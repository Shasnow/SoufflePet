<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SoufflePet"
             x:Class="SoufflePet.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- 视图定位器：按命名约定把 ViewModel 映射成 View -->
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- 窗口共用外观：按控件类型拆分，样式类名在各视图中复用 -->
        <StyleInclude Source="avares://SoufflePet/Styles/Button.axaml" />
        <StyleInclude Source="avares://SoufflePet/Styles/TextBox.axaml" />
        <StyleInclude Source="avares://SoufflePet/Styles/TextBlock.axaml" />
        <StyleInclude Source="avares://SoufflePet/Styles/ListBox.axaml" />
        <StyleInclude Source="avares://SoufflePet/Styles/Border.axaml" />
        <StyleInclude Source="avares://SoufflePet/Styles/Expander.axaml" />
        <StyleInclude Source="avares://SoufflePet/Styles/Picker.axaml" />
    </Application.Styles>
</Application>