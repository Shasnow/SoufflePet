<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 消息气泡：助手靠左浅色，用户靠右强调色 -->
    <Style Selector="Border.bubble">
        <Setter Property="Background" Value="#17FFFFFF" />
        <Setter Property="CornerRadius" Value="12,12,12,4" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MaxWidth" Value="292" />
    </Style>
    <Style Selector="Border.bubble.user">
        <Setter Property="Background" Value="#E8879B" />
        <Setter Property="CornerRadius" Value="12,12,4,12" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- 气泡内文本统一用 :is(TextBlock)，同时覆盖可复制的 SelectableTextBlock -->
    <Style Selector="Border.bubble :is(TextBlock)">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="#F2FFFFFF" />
    </Style>
    <Style Selector="Border.bubble.user :is(TextBlock)">
        <Setter Property="Foreground" Value="#2A141B" />
    </Style>

    <!-- 工具调用记录：弱化描边 + 更小字号，和正式对话区分开 -->
    <Style Selector="Border.bubble.tool">
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="BorderBrush" Value="#22FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,6" />
    </Style>
    <Style Selector="Border.bubble.tool :is(TextBlock)">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="#99FFFFFF" />
    </Style>

    <!-- 思考过程：左侧强调条 + 更淡的文字，与正式回复区分开 -->
    <Style Selector="Border.bubble.thinking">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#40E8879B" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="9,1,0,3" />
    </Style>
    <Style Selector="Border.bubble.thinking :is(TextBlock)">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="#80FFFFFF" />
    </Style>

    <!-- 待审批的工具调用：气泡描边点亮强调色 -->
    <Style Selector="Border.bubble.approval">
        <Setter Property="BorderBrush" Value="#4DE8879B" />
    </Style>

    <!-- 工作区列表项：整行圆角，当前激活项用强调色底色与描边标记 -->
    <Style Selector="Border.workspaceRow">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.workspaceRow.active">
        <Setter Property="Background" Value="#33E8879B" />
        <Setter Property="BorderBrush" Value="#66E8879B" />
    </Style>
</Styles>
